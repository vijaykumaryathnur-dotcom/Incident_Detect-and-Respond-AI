# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HINDSIGHT_API_KEY: Secret API key for Hindsight Agent Memory (Vectorize.io)
HINDSIGHT_API_KEY="MY_HINDSIGHT_API_KEY"

# HINDSIGHT_BANK_ID: Memory bank ID for incident response memories (default: "Incident")
HINDSIGHT_BANK_ID="Incident"

# HINDSIGHT_BASE_URL: Base URL for Hindsight API
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# BACKEND_URL: Target FastAPI backend URL running locally or deployed (default: http://localhost:8000)
# The frontend uses VITE_API_BASE_URL and proxies fallback requests through the Express gateway.
VITE_API_BASE_URL="http://localhost:8000"
FASTAPI_BACKEND_URL="http://localhost:8000"
